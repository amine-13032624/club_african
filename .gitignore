/node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*

# ===== Base de données =====
*.sql
!database/club_sportif.sql
*.db
*.sqlite
.mysql_history

# ===== Configuration sensible =====
config/database.local.php
config/secrets.php
.htpasswd

